{
  "name": "@teacher-assistant/auth",
  "version": "0.0.0",
  "private": true,
  "description": "M0-AUTH (H-PUB-1): passkeys/WebAuthn as the PRIMARY factor (no password path), rate-limiting + lockout (H-PUB-5), and the binding that a verified passkey auth unlocks the device-held wrapped keys. Framework-agnostic; the sync-relay (M2) consumes it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.2",
    "@teacher-assistant/crypto": "workspace:*",
    "@teacher-assistant/schema": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "~4.1.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.10"
  }
}
