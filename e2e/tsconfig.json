{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // DOM is needed for `page.evaluate` callbacks, which run in the browser and
    // reference browser globals (document, window) though they are type-checked here.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["tests", "playwright.config.ts"]
}
