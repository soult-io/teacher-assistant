# Teacher Assistant — example env for LOCAL DEV ONLY.
# Production/QA config + real secrets live in the deploy-stack repo
# (nsoult-agentic/stack-lexington-teacher-assistant), never here. Under D1,
# encryption keys never leave the client and are never placed in any env.

# Public URL the client reaches the app on (behind the Lexington NPM, TLS there).
# Deploy posture B (D-ARCH-3): PUBLIC HTTPS via the Lexington NPM + hardened auth.
BASE_URL=http://localhost:5173

# --- sync-relay (opaque encrypted-blob relay; NEVER decrypts) ---
SYNC_RELAY_PORT=8931
# Postgres holding ciphertext blobs + opaque metadata only (no readable PII).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teacher_assistant
DB_USER=teacher_assistant
# DB password is read from a file (SECRETS_DIR), never from an env value.
SECRETS_DIR=./secrets

# --- content-api (NON-PII reference: curriculum/segments/KY std/MYP ref/calendar) ---
CONTENT_API_PORT=8932

# --- diff-orchestrator (DE-IDENTIFIED differentiation prompts only; logs no bodies) ---
DIFF_ORCHESTRATOR_PORT=8933
# External LLM endpoint the orchestrator calls with de-identified payloads only.
# The API key is read from SECRETS_DIR/llm-api-key, never from an env value.
LLM_API_BASE_URL=
