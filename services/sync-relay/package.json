{
  "name": "@teacher-assistant/sync-relay",
  "version": "0.0.0",
  "private": true,
  "description": "M2 sync-relay: authenticated append-only encrypted-update log + fetch, keyed by opaque doc-id, per-device-pubkey ACL. NEVER decrypts — stores/serves ciphertext it cannot read. H-PUB-3 zero-existence for unauthorized streams; H-PUB-4 identity-clean surface.",
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@teacher-assistant/schema": "workspace:*",
    "fastify": "~5.12.0",
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "~26.6.1",
    "tsx": "~4.23.12",
    "typescript": "~7.0.2",
    "vitest": "~5.0.1"
  }
}
