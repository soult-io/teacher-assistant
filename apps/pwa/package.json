{
  "name": "@teacher-assistant/pwa",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first installable PWA (React + Vite + vite-plugin-pwa). The TRACK UI renders the engine's M3 projections from the local encrypted store; student-linked data is served exclusively from that store, never the HTTP cache. App shell + design system + auth/unlock/sync bootstrap land in U1; the TRACK screens follow per the UI build spec.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@teacher-assistant/auth": "workspace:*",
    "@teacher-assistant/crypto": "workspace:*",
    "@teacher-assistant/domain-core": "workspace:*",
    "@teacher-assistant/schema": "workspace:*",
    "@teacher-assistant/store": "workspace:*",
    "@teacher-assistant/sync": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@simplewebauthn/server": "14.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "~5.0.0"
  }
}
