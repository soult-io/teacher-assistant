{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src"],
  // The service worker is a WebWorker context (no DOM); it is type-checked on its
  // own via tsconfig.sw.json and compiled by vite-plugin-pwa, not by this project.
  "exclude": ["src/sw.ts"]
}
